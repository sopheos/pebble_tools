{
    "name": "sopheos/pebble_tools",
    "description": "PHP helpers: arrays, strings, dates, bitwise flags, IP conversion, GPS points and Imagick images",
    "license": "MIT",
    "require": {
        "php": ">=8.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "ext-imagick": "Requis par Pebble\\Tools\\Image (extends Imagick)"
    },
    "autoload": {
        "psr-4": {
            "Pebble\\Tools\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
